# School Server configuration (copy to .env and fill in your values; chmod 600 .env)

# E-journal addresses (https:// required; no defaults)
SCHOOL_JOURNAL_URL=
SCHOOL_JOURNAL_API_URL=
SCHOOL_JOURNAL_MESSAGES_URL=
# Required when SCHOOL_LOGIN is a school-issued numeric ID (without @)
SCHOOL_JOURNAL_GATEWAY_URL=

# Optional child id or login when a parent account has several children (defaults to first)
SCHOOL_CHILD=

# Parent portal credentials
SCHOOL_LOGIN=
SCHOOL_PASSWORD=
# Optional path to a file containing the password (overrides SCHOOL_PASSWORD)
SCHOOL_PASSWORD_FILE=

# API key for clients calling this server (X-School-Key header). Leave empty only on a trusted LAN.
SCHOOL_API_KEY=

# Set to 'cloudflare' when running behind a Cloudflare Tunnel (requires SCHOOL_API_KEY)
TRUST_PROXY=

# Sync interval in minutes (default 15, minimum 5)
# SYNC_INTERVAL_MINUTES=15

# SQLite database path (default /data/school.db in Docker, school.db locally)
# SCHOOL_DB_PATH=/data/school.db

# HTTP port (default 5100)
# PORT=5100

# Log level: DEBUG, INFO, WARN, ERROR (default INFO)
# LOG_LEVEL=INFO
